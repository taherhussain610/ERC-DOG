PORT=4000
NODE_ENV=development
JWT_SECRET=change-this-to-a-strong-random-secret

# CORS — comma-separated allowed origins
CORS_ORIGIN=http://localhost:4000

# Domain Configuration
DOMAIN=localhost
API_URL=http://localhost:4000/api
WEBSOCKET_URL=ws://localhost:4000

# Solana RPC (Tatum gateway or any Solana JSON-RPC endpoint)
SOLANA_RPC_URL=https://solana-mainnet.gateway.tatum.io
SOLANA_RPC_API_KEY=YOUR_TATUM_API_KEY

# Ethereum RPC
ETH_RPC_URL=https://ethereum.publicnode.com
ETH_RPC_API_KEY=

# BSC RPC (Tatum gateway or public endpoint)
BSC_RPC_URL=https://bsc-mainnet.gateway.tatum.io
BSC_RPC_API_KEY=YOUR_TATUM_API_KEY
BSC_RPC_FALLBACK_URL=https://bsc-dataseed.binance.org

# TRON RPC — network: mainnet | shasta | nile
TRON_NETWORK=mainnet
TRON_RPC_API_KEY=YOUR_TATUM_API_KEY

# TRON Mainnet Endpoints
TRON_MAINNET_JSONRPC=https://YOUR_TATUM_GATEWAY.gateway.tatum.io/jsonrpc
TRON_MAINNET_WALLET=https://tron-mainnet.gateway.tatum.io/wallet
TRON_MAINNET_WALLETSOLIDITY=https://tron-mainnet.gateway.tatum.io/walletsolidity

# TRON Shasta Testnet
TRON_SHASTA_JSONRPC=https://tron-shasta.gateway.tatum.io/jsonrpc
TRON_SHASTA_WALLET=https://tron-shasta.gateway.tatum.io/wallet
TRON_SHASTA_WALLETSOLIDITY=https://tron-shasta.gateway.tatum.io/walletsolidity

# TRON Nile Testnet
TRON_NILE_JSONRPC=https://tron-nile.gateway.tatum.io/jsonrpc
TRON_NILE_WALLET=https://tron-nile.gateway.tatum.io/wallet
TRON_NILE_WALLETSOLIDITY=https://tron-nile.gateway.tatum.io/walletsolidity

# Tatum Data API — get a key at https://dashboard.tatum.io
TATUM_API_KEY=YOUR_TATUM_API_KEY
TATUM_DATA_API_URL=https://api.tatum.io

# Cache
BSC_WALLET_CACHE_MS=15000

# Hardhat local node (used by HardhatService)
HARDHAT_RPC_URL=http://127.0.0.1:8545

# MetaTrader API — get a key from your MetaTrader broker
METATRADER_API_KEY=YOUR_METATRADER_API_KEY
METATRADER_API_URL=https://api.metatrader.com/v1

# Email / SMTP (MailRCLD or any SMTP provider)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=your-smtp-user@example.com
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=Crypto Exchange
ADMIN_EMAIL=admin@example.com
SMTP_TRACK_OPENS=false
SMTP_TRACK_INBOX=true
SMTP_CAMPAIGN_ID=transactional


# ─── MongoDB (optional — for future migration from SQLite) ────────────────────
# Obtain connection string from https://cloud.mongodb.com → Connect → Drivers
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
# NEVER paste real credentials here — use your local .env file only
MONGODB_URI=******YOUR_CLUSTER.mongodb.net/erc_dog?retryWrites=true&w=majority
MONGODB_DB_NAME=erc_dog
